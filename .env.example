# FFC (Friends Fried Chicken) — Environment Configuration Template
# Copy this file to .env.local for local development

# Next.js Public Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME="Friends Fried Chicken"

# API & Backend Services (if applicable)
DATABASE_URL=
NEXT_PUBLIC_API_URL=

# Payment Provider Integration (e.g. Razorpay / Stripe)
NEXT_PUBLIC_PAYMENT_KEY=
PAYMENT_SECRET_KEY=
